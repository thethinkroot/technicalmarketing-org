#!/bin/sh
#
# Pre-push gate for technicalmarketing.org.
#
# Blocks a push when any sitemap entry, internal link, hreflang tag or IndexNow URL
# points at a redirecting or non-existent URL. This is the check that would have
# caught the July 2026 "Page with redirect" failures in Google Search Console
# before they shipped.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass in an emergency (and fix immediately after):
#     git push --no-verify

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — skipping seo-check." >&2
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
CHECK="$ROOT/tools/seo-check.mjs"

echo "pre-push: running seo-check on the working tree…"

if ! node "$CHECK"; then
  echo ""
  echo "pre-push: BLOCKED. Fix the violations above, or push with --no-verify if you"
  echo "          have accepted them deliberately." >&2
  exit 1
fi

# Each outgoing commit must also be internally consistent: a commit whose
# sitemap advertises a page it does not contain would serve 404s if deployed,
# and the working-tree check above cannot see that.
if UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  COMMITS=$(git rev-list "$UPSTREAM"..HEAD --reverse)
  if [ -n "$COMMITS" ]; then
    COUNT=$(printf '%s\n' "$COMMITS" | wc -l | tr -d ' ')
    echo "pre-push: validating $COUNT outgoing commit(s) against $UPSTREAM…"
    for c in $COMMITS; do
      if ! node "$CHECK" --commit "$c"; then
        echo ""
        echo "pre-push: BLOCKED. The commit above is not internally consistent." >&2
        echo "          Restage so each commit contains the pages its sitemap lists." >&2
        exit 1
      fi
    done
  else
    echo "pre-push: no outgoing commits."
  fi
else
  echo "pre-push: no upstream configured — skipping per-commit validation."
fi

exit 0
