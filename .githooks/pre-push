#!/bin/sh
#
# Pre-push gate for technicalmarketing.org.
#
# Blocks a push when any sitemap entry, internal link, hreflang tag or IndexNow URL
# points at a redirecting or non-existent URL. This is the check that would have
# caught the July 2026 "Page with redirect" failures in Google Search Console
# before they shipped.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass in an emergency (and fix immediately after):
#     git push --no-verify

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — skipping seo-check." >&2
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
CHECK="$ROOT/tools/seo-check.mjs"
TERMS="$ROOT/tools/term-check.mjs"

echo "pre-push: running seo-check on the working tree…"

if ! node "$CHECK"; then
  echo ""
  echo "pre-push: BLOCKED. Fix the violations above, or push with --no-verify if you"
  echo "          have accepted them deliberately." >&2
  exit 1
fi

# Settled glossary terms must render consistently inside each translated page.
# Catches regressions of defects already recorded in translations/glossary.md; it
# cannot recognise a paraphrase nobody has seen before, so it supplements reading
# the pages rather than replacing it.
if [ -f "$TERMS" ]; then
  echo "pre-push: running term-check…"
  if ! node "$TERMS"; then
    echo ""
    echo "pre-push: BLOCKED. A settled glossary term renders inconsistently." >&2
    echo "          Fix the page, or update translations/glossary.md if the decision changed." >&2
    exit 1
  fi
fi

# Each outgoing commit must also be internally consistent: a commit whose
# sitemap advertises a page it does not contain would serve 404s if deployed,
# and the working-tree check above cannot see that.
# Determine what to compare against. A branch with no upstream is the normal
# case for new work, so falling back matters: skipping validation there would
# disable the guard exactly where unreviewed commits are created.
BASE=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
if [ -z "$BASE" ]; then
  for candidate in origin/main origin/master; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null; then BASE="$candidate"; break; fi
  done
fi

if [ -n "$BASE" ]; then
  COMMITS=$(git rev-list "$BASE"..HEAD --reverse)
  LABEL="against $BASE"
else
  # No remote to compare with at all — validate the tip rather than nothing.
  COMMITS=$(git rev-parse HEAD)
  LABEL="(no remote found — validating HEAD only)"
fi

if [ -n "$COMMITS" ]; then
  COUNT=$(printf '%s\n' "$COMMITS" | wc -l | tr -d ' ')
  echo "pre-push: validating $COUNT commit(s) $LABEL…"
  for c in $COMMITS; do
    if ! node "$CHECK" --commit "$c"; then
      echo ""
      echo "pre-push: BLOCKED. The commit above is not internally consistent." >&2
      echo "          Restage so each commit contains the pages its sitemap lists." >&2
      exit 1
    fi
  done
else
  echo "pre-push: no outgoing commits $LABEL."
fi

exit 0
